__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# local runtime state — never commit keys or chains
*.pem

# ...except the frozen conformance fixture's PUBLIC keys, which are published
# on purpose: `qed-verify` cannot check the fixture without them, so a clone
# that silently lacked them would fail CI with `unknown_key` and look like a
# format regression. `*.pem` matched them, and nothing would have said so --
# the same shape as the wheel that shipped without `compliance/packs/*.yaml`.
# `tests/evidence/test_frozen_format.py` now asserts every fixture file is
# tracked by git, so the next rule that swallows one fails loudly.
# There is deliberately no private key in that directory.
!tests/evidence/fixtures/evidence-format-*/public/*.pem
*.db
*.db-journal
*.db-wal
*.db-shm
.qed/
data/
scratch/

# artefacts of the week-1 and week-2 exit criteria, which developers run
# locally as well as in CI. *.pem already covers the keys; an exported chain is
# evidence data, not source, and carries whatever was in the proposals that
# produced it. An OSCAL export is the same data in another shape.
ci-qed/
ci-mcp/
ci-no-keys/
*-chain.jsonl
ci-tampered.jsonl
ci-oscal.json
ci-healthz.json
ci-readyz*.json
ci-serve*.log

# mkdocs build output (SPEC 26). The site is built in CI and published from
# there; a committed copy would be a second, stale answer to every question.
site/
